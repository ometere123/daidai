{
  "name": "daidai-api-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "seed": "npm run build && node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/seed-local.mjs",
    "dev": "npm run build && node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/dev-server.mjs",
    "invite": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/invite.mjs",
    "revoke-sessions": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/revoke-sessions.mjs",
    "migrate:local": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/migrate-local.mjs"
  },
  "devDependencies": {
    "@celo/attribution-tags": "0.5.0",
    "@cloudflare/workers-types": "4.20250718.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "viem": "2.58.4"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    },
    "zod": "4.6.6",
    "sharp": "0.35.5"
  }
}
