# Daidai web: server-only environment (P10.4). Placeholders only. Never prefix any of these with NEXT_PUBLIC_.
# Read-only API (Cloudflare Worker) base URL. https only (http allowed for 127.0.0.1/localhost).
DAIDAI_API_BASE_URL=https://api.example.invalid
# HMAC service key id and secret (>= 32 chars). Must match a Worker secret. Set as a Vercel server env var.
DAIDAI_SERVICE_KEY_ID=replace-me
DAIDAI_SERVICE_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Internal authoritative demo: off unless exactly "1". Always off when VERCEL_ENV=production.
DAIDAI_INTERNAL_DEMO=0
# Local `next start` testing only (NODE_ENV=production). NEVER set this on Vercel.
# DAIDAI_INTERNAL_DEMO_ALLOW_PROD_BUILD=1
# Viewer session token for the internal demo, issued server-side out of band.
DAIDAI_DEMO_VIEWER_TOKEN=
