# Daidai web: server-only environment (P10.5). Placeholders only. Never prefix any of these with NEXT_PUBLIC_.
# Daidai API (Cloudflare Worker) base URL. https only (http allowed for 127.0.0.1/localhost).
DAIDAI_API_BASE_URL=https://api.example.invalid
# HMAC service key id and secret (>= 32 chars). Must match a Worker secret. Set as a Vercel server env var.
DAIDAI_SERVICE_KEY_ID=replace-me
DAIDAI_SERVICE_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Authenticated read-only app (/login, /invoices, /logout). Off unless exactly "1".
# Required on Vercel Production (VERCEL_ENV=production) and for local `next start`. A session is ALWAYS also required.
DAIDAI_APP_ENABLED=0
# Vercel Preview (VERCEL_ENV=preview) only: private routes 404 unless exactly "1". A session is ALWAYS also required.
DAIDAI_PREVIEW_ACCESS=0

# Isolated loopback product demo only. Enable only with the local Miniflare Worker. Unavailable on Vercel.
DAIDAI_LOCAL_PRODUCT=0
